# Copy to .env and fill in. Never commit .env.

# Runtime model on the course server (dingo) — values from the course config, never committed
DINGO_BASE_URL=
DINGO_API_KEY=
DINGO_MODEL=

# Telegram delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEC EDGAR requires a User-Agent with contact info: "<app name> <email>"
SEC_USER_AGENT="stock-briefing-agent you@example.com"
