{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*.local)",
      "Read(./**/models.json)",
      "Bash(cat .env*)",
      "Bash(git push --force:*)"
    ],
    "allow": [
      "Bash(pytest:*)",
      "Bash(uv run pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr view:*)"
    ]
  }
}
